# Porta pública do nginx (única porta que precisa estar aberta)
NGINX_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=techx
MYSQL_USER=techx
MYSQL_PASSWORD=techx_secret
MYSQL_HOST_PORT=3306

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root_secret
MONGO_DATABASE=techx_logs
MONGO_HOST_PORT=27017

# Api
API_PORT=3000
LOG_RETENTION_DAYS=30

# Auth — em produção gere um segredo real: openssl rand -hex 32
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=1h
