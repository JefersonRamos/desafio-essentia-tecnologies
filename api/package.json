{
  "name": "techx-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:shadow": "DATABASE_URL=\"${SHADOW_DATABASE_URL%/*}/${MYSQL_DATABASE}\" prisma db execute --file prisma/shadow.sql",
    "migrate": "npm run db:shadow && prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "i18next": "^26.3.6",
    "i18next-http-middleware": "^3.9.8",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "pino": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
